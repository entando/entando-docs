@font-face {
  font-family: Montblanc;
  src: url('/theme/fonts/MontBlanc-Light.woff2') format('woff2');
  font-weight: 300;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: Montblanc;
  src: url('/theme/fonts/MontBlanc-Regular.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: Montblanc;
  src: url('/theme/fonts/MontBlanc-SemiBold.woff2') format('woff2');
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: Montblanc;
  src: url('/theme/fonts/MontBlanc-Bold.woff2') format('woff2');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: Roboto;
  src: url('/theme/Roboto-Regular.ttf');
}

body {
  font-family: Montblanc, Montserrat, Roboto, sans-serif;
  color: $textColor;
  background: #FFFFFF;
}

h1, h2, h3, h4, h5, h6 {
  font-family: Montblanc, Montserrat, Roboto, sans-serif;
}

.page h1 {
  color: $accentColor;
}

.theme-container .navbar {
  background: #F9FBFE;
  border-bottom: 1px solid #E5E8E9;
  height: 8.5rem;
}

.theme-container .entando-navbar {
  color: white;
  background-color: $accentColor;
  font-size: 1rem;
  padding: 0 1.5rem;
  margin: 0 -1.5rem;
  line-height: 4rem;
}

.theme-container .entando-navbar a {
  color: white;
}

.theme-container .entando-navbar a:hover,
.theme-container .entando-navbar a.router-link-active {
  color: white;
  text-decoration: none;
  border-bottom: $entandoLightBlue solid 2px;
}

.theme-container .entando-navbar .search-box{
  float:right;
}

.theme-container .sidebar {
  top: 8.5rem;
}

.theme-container .navbar .logo {
  height: 2em;
}

.theme-container .navbar .site-name {
  color: white;
}

.theme-container .navbar .links, .theme-container .navbar .links a:hover  {
  background: transparent;
  color: $accentColor;
  font-size: 1rem;
  letter-spacing: 0;
  text-transform: none;
}

.theme-container .navbar .home-link * {
  vertical-align: middle;
}

.theme-container .navbar a.repo-link {
  display: none;
}

.theme-container .theme-default-content:not(.custom) {
  max-width: 740px;
  margin: 0 auto;
  padding: 2rem 2.5rem;
  background: #FFFFFF;
}

.theme-default-content:not(.custom) > h1:first-child,
.theme-default-content:not(.custom) > h2:first-child,
.theme-default-content:not(.custom) > h3:first-child,
.theme-default-content:not(.custom) > h4:first-child,
.theme-default-content:not(.custom) > h5:first-child,
.theme-default-content:not(.custom) > h6:first-child {
  margin-top: 1.5rem;
}

.theme-default-content:not(.custom) > .custom-block:first-child {
  margin-top: 8rem;
}

.nav-item a, .nav-item .title {
  font-family: 'Montblanc', 'Montserrat', 'Roboto', sans-serif !important;
  font-weight: 500 !important;
  color: $accentColor;
  letter-spacing: 0;
  text-transform: none;
}

.nav-links .nav-item .title {
  font-size: 1rem;
  line-height: 2rem;
}

.nav-item a:hover, .nav-item a.router-link-active {
  text-decoration: underline;
}

.theme-container .navbar > .links .nav-links .nav-item > a:hover,
.theme-container .navbar > .links .nav-links .nav-item > a.router-link-active {
  color: $accentColor;
  text-decoration: none;
  border-bottom: 2px solid $entandoLightBlue;
}

.theme-container .navbar > .links .dropdown-wrapper .dropdown-title:hover .title {
  color: $accentColor;
  text-decoration: none;
  border-bottom: 2px solid $entandoLightBlue;
}

.nav-links .dropdown-wrapper .arrow {
  display:none;
}

@media (max-width: 719px) {
  .dropdown-wrapper .dropdown-title {
    color: $accentColor !important;
  }

  .theme-container .navbar {
    height: 5rem;
  }

  .theme-container .navbar .entando-navbar {
    display:none;
  }
}

@media print {
  .navbar,
  .sidebar,
  .sidebar-mask,
  .page-edit,
  .page-nav {
    display: none;
  }
}

.nav-item > a:not(.external):hover, .nav-item > a:not(.external).router-link-active {
  border-bottom: 2px solid $entandoLightBlue !important;
}

.nav-links .icon.outbound {
  display: none;
}

.navbar a .can-hide {
  display: none;
}

.nav-dropdown {
  z-index: 100;
}

.nav-dropdown .dropdown-item, .nav-dropdown .dropdown-item a:hover,.dropdown-item a.router-link-active {
  color: $accentColor !important;
}

.links .search-box input {
  border: 1px solid $accentColor;
  border-radius: 4px;
}

.links .search-box .suggestions {
  font-size: 1.1rem;
}

.theme-container .sidebar {
  background: #F9FBFE;
  border-right: 1px solid #E5E8E9;
}

.theme-container .sidebar-button {
  float:right;
  position: relative;
}

.theme-container .sidebar > .sidebar-links {
  padding-top: 0.5rem;
}

.sidebar-group.is-sub-group > .sidebar-heading:not(.clickable) {
  opacity: 1 !important;
  color: $darkTextColor;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.sidebar-sub-headers a.sidebar-link.active {
  font-weight: 700 !important;
  color: $accentColor !important;
  border-left: 4px solid $entandoYellow;
  padding-left: 12px;
}

.page .custom-block.tip {
  border-color: $entandoLightBlue;
  background: #F3F4F8;
}

.theme-default-content .custom-block {
  border-radius: 6px;
  border-left-width: 4px;
  box-shadow: 0 8px 20px rgba(12, 28, 43, 0.04);
}

.theme-default-content .custom-block.warning {
  border-color: $entandoYellow;
}

.theme-default-content .custom-block.danger {
  border-color: $entandoRed;
}

.theme-default-content a {
  color: $accentColor;
  text-decoration-thickness: 2px;
  text-underline-offset: 0.15em;
}

.theme-default-content a:hover {
  color: $entandoDarkBlue;
}

pre {
  border-radius: 6px;
  border: 1px solid #E5E8E9;
  box-shadow: 0 8px 20px rgba(12, 28, 43, 0.04);
  background: #FFFFFF;
  color: $entandoDarkBlue;
}

pre code,
div[class*="language-"] {
  font-family: 'Roboto Mono', monospace;
  color: $entandoDarkBlue;
}

div[class*="language-"] {
  border-radius: 6px;
  border: 1px solid #E5E8E9;
  box-shadow: 0 8px 20px rgba(12, 28, 43, 0.04);
  background: #FFFFFF;
  color: $entandoDarkBlue;
}

div[class*="language-"] pre {
  background: #FFFFFF;
  color: $entandoDarkBlue;
}

div[class*="language-"] code,
div[class*="language-"] .token {
  color: $entandoDarkBlue !important;
}

div[class*="language-"] .token.property,
div[class*="language-"] .token.attr-name,
div[class*="language-"] .token.keyword {
  color: $accentColor !important;
}

div[class*="language-"] .token.string,
div[class*="language-"] .token.attr-value {
  color: #4D7114 !important;
}

div[class*="language-"] .token.number,
div[class*="language-"] .token.boolean,
div[class*="language-"] .token.function {
  color: #6B4B86 !important;
}

div[class*="language-"] .token.comment,
div[class*="language-"] .token.punctuation {
  color: #66717D !important;
}

.theme-default-content .custom-block-title {
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.theme-default-content h1,
.theme-default-content h2,
.theme-default-content h3,
.theme-default-content h4 {
  color: $darkTextColor;
  letter-spacing: 0.01em;
}

.theme-default-content h2 {
  border-bottom: 1px solid #E5E8E9;
  padding-bottom: 0.35rem;
}

.theme-default-content table {
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid #E5E8E9;
}

.theme-default-content table thead {
  background: #F9FBFE;
}

/* Copy-code plugin to avoid extra whitespace */
pre .code-copy {
  margin-top: -0.85rem;
  color: $entandoLightBlue;
}
